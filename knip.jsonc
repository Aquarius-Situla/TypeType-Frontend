{
  "$schema": "https://unpkg.com/knip@latest/schema-jsonc.json",
  "workspaces": {
    ".": {
      "ignore": [".venv-browserbase/**", ".venv-playwright/**"],
      "ignoreDependencies": [
        // Required by @vidstack/react at build time. Do not remove.
        "media-icons",
        // Kept for 3D work while the Halloween theme is archived.
        "three",
        "@types/three"
      ]
    }
  }
}
