{
  "name": "@typetype/web",
  "private": true,
  "version": "1.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "localize": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
    "build": "bun run localize && tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test --preload ./tests/setup.ts",
    "test:coverage": "bun test --preload ./tests/setup.ts --coverage --coverage-reporter=lcov"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@typetype/mse": "0.1.76",
    "@vidstack/react": "1.15.7",
    "@zip.js/zip.js": "^2.24.0",
    "dashjs": "^5.2.1",
    "hls.js": "1.7.3",
    "lucide-react": "^1.61.0",
    "media-icons": "1.1.5",
    "mpegts.js": "1.8.2",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "three": "0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
